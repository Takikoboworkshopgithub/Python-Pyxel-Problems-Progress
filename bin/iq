#!/usr/bin/env bash

set -e

# ============================================================
# IQ Programming Practice
# CLI
# ============================================================

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ------------------------------------------------------------
# Color
# ------------------------------------------------------------

if [ -t 1 ]; then
    GREEN='\033[32m'
    YELLOW='\033[33m'
    RED='\033[31m'
    CYAN='\033[36m'
    BLUE='\033[34m'
    RESET='\033[0m'
    BOLD='\033[1m'
else
    GREEN=''
    YELLOW=''
    RED=''
    CYAN=''
    BLUE=''
    RESET=''
    BOLD=''
fi

# ------------------------------------------------------------
# Message
# ------------------------------------------------------------

info() {
    echo -e "${CYAN}[INFO]${RESET} $1"
}

success() {
    echo -e "${GREEN}[ OK ]${RESET} $1"
}

warning() {
    echo -e "${YELLOW}[WARN]${RESET} $1"
}

error() {
    echo -e "${RED}[ERROR]${RESET} $1"
}

# ------------------------------------------------------------
# Help
# ------------------------------------------------------------

show_help() {
    echo
    echo -e "${BOLD}IQ Programming Practice${RESET}"
    echo
    echo "Usage:"
    echo "  iq <command> [options]"
    echo
    echo "Commands:"
    echo "  exec <file>             ファイルを通常実行する"
    echo "  excuse <file>           問題のテストケースで採点する"
    echo "  confirm <lecture>       指定講の進捗を確認する"
    echo "  status                  全体の進捗を確認する"
    echo "  makeid <name>           学生情報を登録する"
    echo "  version                 バージョンを表示する"
    echo "  ac -force <task>        問題を手動でACにする"
    echo "  help                    ヘルプを表示する"
    echo
}

# ------------------------------------------------------------
# Node.js check
# ------------------------------------------------------------

check_node() {

    if ! command -v node >/dev/null 2>&1; then
        error "Node.js がインストールされていません。"
        exit 1
    fi
}

# ------------------------------------------------------------
# exec
# ------------------------------------------------------------

exec_program() {

    if [ -z "${1:-}" ]; then
        error "実行するファイルを指定してください。"
        echo
        echo "Usage: iq exec <file>"
        exit 1
    fi

    FILE="$1"

    if [ ! -f "$FILE" ]; then
        error "ファイルが見つかりません: $FILE"
        exit 1
    fi

    EXT="${FILE##*.}"

    case "$EXT" in

        py)
            if ! command -v python3 >/dev/null 2>&1; then
                warning "Python3 がインストールされていません。"
                exit 1
            fi

            python3 "$FILE"
            ;;

        c)
            if ! command -v gcc >/dev/null 2>&1; then
                warning "gcc がインストールされていません。"
                exit 1
            fi

            TEMP_EXEC="$(mktemp)"

            trap 'rm -f "$TEMP_EXEC"' EXIT

            gcc "$FILE" -o "$TEMP_EXEC"

            "$TEMP_EXEC"
            ;;

        cpp|cc|cxx)
            if ! command -v g++ >/dev/null 2>&1; then
                warning "g++ がインストールされていません。"
                exit 1
            fi

            TEMP_EXEC="$(mktemp)"

            trap 'rm -f "$TEMP_EXEC"' EXIT

            g++ "$FILE" -o "$TEMP_EXEC"

            "$TEMP_EXEC"
            ;;

        *)
            error "対応していない拡張子です: .$EXT"
            echo
            echo "対応:"
            echo "  Python : .py"
            echo "  C      : .c"
            echo "  C++    : .cpp / .cc / .cxx"
            exit 1
            ;;

    esac
}

# ------------------------------------------------------------
# excuse
# ------------------------------------------------------------

excuse() {

    if [ -z "${1:-}" ]; then
        error "採点するファイルを指定してください。"
        echo
        echo "Usage: iq excuse <file>"
        exit 1
    fi

    FILE="$1"

    if [ ! -f "$FILE" ]; then
        error "ファイルが見つかりません: $FILE"
        exit 1
    fi

    check_node

    RESULT="$(
        node "$ROOT_DIR/server.js" --excuse "$FILE" 2>&1
    )"

    EXIT_CODE=$?

    echo "$RESULT"

    if [ "$EXIT_CODE" -eq 0 ]; then
        success "AC"
    else
        warning "採点が終了しました。"
    fi

    return "$EXIT_CODE"
}

# ------------------------------------------------------------
# confirm
# ------------------------------------------------------------

confirm() {

    if [ -z "${1:-}" ]; then
        error "講座番号を指定してください。"
        echo
        echo "Usage: iq confirm <lecture>"
        exit 1
    fi

    check_node

    node "$ROOT_DIR/server.js" --confirm "$1"
}

# ------------------------------------------------------------
# status
# ------------------------------------------------------------

status() {

    check_node

    node "$ROOT_DIR/server.js" --status
}

# ------------------------------------------------------------
# makeid
# ------------------------------------------------------------

makeid() {

    if [ -z "${1:-}" ]; then
        error "名前を指定してください。"
        echo
        echo "Usage: iq makeid \"name\""
        exit 1
    fi

    NAME="$1"

    check_node

    node "$ROOT_DIR/server.js" --makeid "$NAME"
}

# ------------------------------------------------------------
# version
# ------------------------------------------------------------

version() {

    echo
    echo -e "${BOLD}IQ Programming Practice${RESET}"
    echo "Version: 1.0.0"
    echo "Node.js: $(node --version 2>/dev/null || echo 'not found')"
    echo
}

# ------------------------------------------------------------
# force AC
# ------------------------------------------------------------

force_ac() {

    if [ "${1:-}" != "-force" ]; then
        error "手動ACには -force が必要です。"
        echo
        echo "Usage: iq ac -force <task_id>"
        exit 1
    fi

    if [ -z "${2:-}" ]; then
        error "問題番号を指定してください。"
        echo
        echo "Usage: iq ac -force <task_id>"
        exit 1
    fi

    TASK_ID="$2"

    check_node

    node "$ROOT_DIR/server.js" --force-ac "$TASK_ID"
}

# ------------------------------------------------------------
# Main
# ------------------------------------------------------------

COMMAND="${1:-}"

case "$COMMAND" in

    exec)
        shift
        exec_program "$@"
        ;;

    excuse)
        shift
        excuse "$@"
        ;;

    confirm)
        shift
        confirm "$@"
        ;;

    status)
        status
        ;;

    makeid)
        shift
        makeid "$@"
        ;;

    version)
        version
        ;;

    ac)
        shift
        force_ac "$@"
        ;;

    help|-h|--help|"")
        show_help
        ;;

    *)
        error "不明なコマンドです: $COMMAND"
        echo
        show_help
        exit 1
        ;;

esac